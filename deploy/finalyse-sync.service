# Gabarit — adapter User et le chemin d'installation avant `systemctl enable`.
#   sed -i 's|/opt/finalyse|/chemin/vers/finalyse|g; s|^User=.*|User=<compte>|' finalyse-sync.service

[Unit]
Description=finalyse — sync quotidien des cours EODHD → Supabase
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=finalyse
WorkingDirectory=/opt/finalyse
EnvironmentFile=/opt/finalyse/.env
Environment=PYTHONPATH=/opt/finalyse
ExecStart=/opt/finalyse/.venv/bin/python -m finalyse.sync_supabase --universe all
